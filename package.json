{
  "name": "kulumasiina-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "tsx ./src/db/migrate.ts",
    "cleanup-orphaned-files": "tsx ./src/lib/cleanupOrphanedFiles.ts",
    "preinstall": "npx only-allow pnpm",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@cantoo/pdf-lib": "^2.9.1",
    "@react-pdf/renderer": "^4.6.1",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-table": "^9.1.2",
    "@zip.js/zip.js": "^2.8.55",
    "compress-pdf": "^0.6.3",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "ibantools": "^4.5.4",
    "jose": "^6.2.10",
    "lucide-react": "^1.33.0",
    "next": "^16.3.2",
    "next-intl": "^4.13.7",
    "next-safe-action": "^8.6.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "s3mini": "^1.0.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "NODE_OPTIONS='--experimental-strip-types' pnpm exec lint-staged"
  },
  "packageManager": "pnpm@11.22.0"
