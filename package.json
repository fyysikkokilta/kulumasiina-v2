{
  "name": "kulumasiina-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "tsx ./src/db/migrate.ts",
    "cleanup-orphaned-files": "tsx ./src/lib/cleanupOrphanedFiles.ts",
    "preinstall": "npx only-allow pnpm",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@cantoo/pdf-lib": "^2.11.1",
    "@react-pdf/renderer": "^4.9.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-table": "^9.3.1",
    "@zip.js/zip.js": "^2.23.0",
    "compress-pdf": "^0.6.3",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.8",
    "drizzle-orm": "1.0.0-rc.4",
    "ibantools": "^4.5.4",
    "jose": "^6.2.12",
    "lucide-react": "^1.58.0",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "next-safe-action": "^8.7.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "s3mini": "^1.0.3",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "1.0.0-rc.4",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "postcss": "^8.5.30",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "NODE_OPTIONS='--experimental-strip-types' pnpm exec lint-staged"
  },
  "packageManager": "pnpm@12.14.0"
}
